<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for every Firestore/Auth call and for opening Uber/Ola/Rapido via deep link. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OffCampusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OffCampus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OffCampus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Catches the magic-link sign-in URL Firebase Auth emails out (see
                AuthViewModel.sendMagicLink()). autoVerify makes Android confirm ownership of
                offcampus-5f370.web.app against public/.well-known/assetlinks.json before it will
                open this straight into the app instead of a browser — the same "App Links"
                mechanism Firebase's own Dynamic Links used to paper over, now done directly since
                Dynamic Links shut down in 2025.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="offcampus-5f370.web.app"
                    android:pathPrefix="/finishSignIn" />
            </intent-filter>
        </activity>
    </application>

</manifest>
