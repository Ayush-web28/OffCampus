<?xml version="1.0" encoding="utf-8"?>
<!-- OffCampus brand transit mark: outbound mobility loop with directional departure arrow and pooled passenger nodes -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Campus Outbound Transit Route Ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M 52,75 C 40.4,75 31,65.6 31,54 C 31,42.4 40.4,33 52,33 C 60,33 67,37.5 70.5,44" />

    <!-- Shared Pooling Arc (Accent Green) -->
    <path
        android:strokeColor="#4ADE80"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M 72.5,54 C 72.5,64 64.5,73.5 53,74.8" />

    <!-- Outbound Route Arrow Stem -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M 54,54 L 74,34" />

    <!-- Outbound Route Arrow Head -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 60,33 L 75,33 L 75,48" />

    <!-- Origin Campus Gate Waypoint Node -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44,54 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />

    <!-- Central Pooled Rider Node -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,45 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />

    <!-- Destination Node (Accent Green) -->
    <path
        android:fillColor="#4ADE80"
        android:pathData="M 64,54 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />
</vector>
